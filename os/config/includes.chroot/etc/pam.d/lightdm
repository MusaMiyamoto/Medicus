#%PAM-1.0
# Medicus: graphical login only with a health-personnel card (+ PIN) or emergency access.
# Passwords are never accepted. Anyone not in a Medicus group is refused.
# The two "success=N" lines skip ahead for health personnel and IT staff; everyone else
# must be the emergency account.

auth      requisite                   pam_nologin.so
auth      [success=2 default=ignore]  pam_succeed_if.so quiet user ingroup medicus-personell
auth      [success=1 default=ignore]  pam_succeed_if.so quiet user ingroup medicus-it
auth      requisite                   pam_succeed_if.so quiet user ingroup medicus-nod
auth      [success=done ignore=ignore default=die]  pam_exec.so quiet expose_authtok stdout /usr/local/lib/medicus/pam-medicus
# The second "credentials" step (pam_setcred) has nothing to do for card logins.
auth      required                    pam_permit.so

@include common-account

session  [success=ok ignore=ignore module_unknown=ignore default=bad] pam_selinux.so close
session   required  pam_env.so readenv=1
# The default language (Norwegian). If English was chosen on the login screen,
# /etc/X11/Xsession.d/40medicus-sprak switches the session to it.
session   required  pam_env.so readenv=1 envfile=/etc/default/locale
session   required  pam_limits.so
session   required  pam_loginuid.so
@include common-session
# When the session closes (logout, hold ran out, someone else logged in): empty the home folder.
session   optional  pam_exec.so quiet type=close_session /usr/local/lib/medicus/rydd-hjem
session  [success=ok ignore=ignore module_unknown=ignore default=bad] pam_selinux.so open

# Passwords can't be changed: there are none.
password  requisite pam_deny.so
