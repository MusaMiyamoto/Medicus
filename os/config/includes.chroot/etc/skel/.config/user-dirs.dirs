# Only the folders health workers use. The others (music, video, templates, public) point to
# the home folder itself, which means "not in use", so they are never created.
XDG_DESKTOP_DIR="$HOME/Skrivebord"
XDG_DOCUMENTS_DIR="$HOME/Dokumenter"
XDG_DOWNLOAD_DIR="$HOME/Nedlastinger"
XDG_PICTURES_DIR="$HOME/Bilder"
XDG_MUSIC_DIR="$HOME/"
XDG_VIDEOS_DIR="$HOME/"
XDG_TEMPLATES_DIR="$HOME/"
XDG_PUBLICSHARE_DIR="$HOME/"
