[Icon Theme]
Name=Medicus
Comment=Papirus med Medicus-tilpasninger
# Everything comes from Papirus, except the emblems and app icons below. The app icons replace
# the original programs' own logos, so no other brand shows in windows or the taskbar.
Inherits=Papirus,hicolor
Directories=scalable/emblems,scalable/apps

[scalable/emblems]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Emblems

[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications
