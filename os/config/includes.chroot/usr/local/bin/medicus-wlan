#!/bin/sh
# Machine certificate in the TPM and approved WLANs (IT mode). See wlan/__init__.py. -I: the
# environment can't make this load other code, which matters because it runs as root through sudo.
exec /usr/bin/python3 -I -c "import sys; sys.path.insert(0, '/opt/medicus'); from wlan.__main__ import main; sys.exit(main())" "$@"
