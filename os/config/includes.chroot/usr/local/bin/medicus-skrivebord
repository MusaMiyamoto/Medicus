#!/bin/sh
# Runs at login: the first time, puts the Medicus shortcuts on the desktop and the user's own
# folders in the Files sidebar. Users may change both; they won't be reset.
#
# Home folders are mounted noexec, so a shortcut *file* there can never be "executable", and XFCE
# would warn that it's untrusted. Instead each shortcut is a link to the read-only, executable
# copy in /usr/share/applications, marked trusted with XFCE's checksum.
DONE="$HOME/.config/medicus/skrivebord-klar"
[ -f "$DONE" ] && exit 0
DIR=$(xdg-user-dir DESKTOP 2>/dev/null)
[ -n "$DIR" ] || DIR="$HOME/Skrivebord"
mkdir -p "$DIR" "$(dirname "$DONE")"
for app in medicus-pasient medicus-post medicus-nettleser medicus-kalkulator medicus-sikkerhet; do
  src="/usr/share/applications/$app.desktop"
  dst="$DIR/$app.desktop"
  [ -f "$src" ] || continue
  ln -sfn "$src" "$dst"
  gio set -t string "$dst" metadata::xfce-exe-checksum "$(sha256sum "$src" | cut -d' ' -f1)" 2>/dev/null
done

# Files sidebar: the four folders people actually use, in a fixed order.
mkdir -p "$HOME/.config/gtk-3.0"
: > "$HOME/.config/gtk-3.0/bookmarks"
for kind in DOCUMENTS PICTURES DOWNLOAD; do
  folder=$(xdg-user-dir "$kind" 2>/dev/null)
  [ -n "$folder" ] && [ "$folder" != "$HOME" ] || continue
  mkdir -p "$folder"
  printf 'file://%s %s\n' "$folder" "$(basename "$folder")" >> "$HOME/.config/gtk-3.0/bookmarks"
done
rm -f "$DIR/.keep" "$HOME/Dokumenter/.keep" "$HOME/Nedlastinger/.keep"
touch "$DONE"
