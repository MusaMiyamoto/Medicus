{
  "policies": {
    "WebsiteFilter": {
      "Block": ["<all_urls>"],
      "Exceptions": ["http://127.0.0.1/*", "http://localhost/*"]
    },
    "Proxy": {
      "Mode": "manual",
      "HTTPProxy": "127.0.0.1:8888",
      "UseHTTPProxyForAllProtocols": true,
      "Passthrough": "localhost, 127.0.0.1",
      "Locked": true
    },
    "HttpsOnlyMode": "force_enabled",
    "EnableTrackingProtection": {
      "Value": true, "Locked": true, "Cryptomining": true, "Fingerprinting": true, "EmailTracking": true
    },
    "DNSOverHTTPS": { "Enabled": false, "Locked": true },
    "Homepage": { "URL": "http://127.0.0.1:8000/nettsteder", "Locked": true, "StartPage": "homepage" },
    "Permissions": {
      "Microphone": { "Allow": ["http://127.0.0.1:8000"], "BlockNewRequests": true, "Locked": true },
      "Camera": { "BlockNewRequests": true, "Locked": true },
      "Location": { "BlockNewRequests": true, "Locked": true },
      "Notifications": { "BlockNewRequests": true, "Locked": true }
    },
    "ExtensionSettings": { "*": { "installation_mode": "blocked" } },
    "SearchSuggestEnabled": false,
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableFirefoxAccounts": true,
    "DisableFormHistory": true,
    "DisableDeveloperTools": true,
    "DisableProfileImport": true,
    "DisableSetDesktopBackground": true,
    "BlockAboutConfig": true,
    "BlockAboutProfiles": true,
    "BlockAboutSupport": true,
    "OfferToSaveLogins": false,
    "PasswordManagerEnabled": false,
    "DontCheckDefaultBrowser": true,
    "NoDefaultBookmarks": true,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "PromptForDownloadLocation": false,
    "DownloadDirectory": "/tmp",
    "SanitizeOnShutdown": true,
    "UserMessaging": {
      "WhatsNew": false,
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "SkipOnboarding": true,
      "MoreFromMozilla": false
    }
  }
}
